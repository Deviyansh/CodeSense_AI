# CodeSense AI Environment Configuration

# Application
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database and authentication
MONGODB_URI=mongodb://localhost:27017/codesense-ai
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=codesense-ai
JWT_AUDIENCE=codesense-ai-web

# GitHub integration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY_PATH=secrets/github-app.pem
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GITHUB_APP_SLUG=your-github-app-slug

# AI and queue services
LLM_API_KEY=
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
