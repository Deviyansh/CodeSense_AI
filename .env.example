# CodeSense AI Environment Configuration

# Application
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB and session
MONGODB_URI=mongodb://localhost:27017/codesense-ai
SESSION_SECRET=replace-with-random-secret-32-plus-characters
JWT_ISSUER=codesense-ai
JWT_AUDIENCE=codesense-ai-web

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=secrets/github-app.pem
GITHUB_APP_SLUG=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Queue
REDIS_URL=redis://localhost:6379
SCAN_QUEUE_NAME=codesense-scans
SCAN_WORKER_CONCURRENCY=2

# AI (optional; requires explicit user consent)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Scanner policy
MAX_REPOSITORY_FILES=500
MAX_FILE_SIZE_KB=500
SCAN_TIMEOUT_SECONDS=300
SCANNER_NETWORK_ACCESS=false
LOG_LEVEL=info
